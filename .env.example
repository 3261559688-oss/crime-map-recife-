# Crime Map 环境变量模板
# 部署时复制成 .env 并填真实值（.env 已在 .gitignore）

# ===== LLM 调用（必填） =====
WQ_API_KEY=your-wanqing-api-key-here
WQ_API_URL=https://wanqing-api.corp.kuaishou.com/api/gateway/v1/messages
WQ_MODEL=ep-7zifa0-1777001276406194677

# ===== IP 解析接口（用户提供后填） =====
IP_LOOKUP_URL=https://your-ip-api.corp.kuaishou.com/lookup

# ===== 服务端口（KStation 一般固定 8787） =====
PORT=8787
